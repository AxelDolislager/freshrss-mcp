# FreshRSS MCP Server Configuration
# Copy this file to .env and fill in your values

# Your FreshRSS instance URL (e.g., https://rss.example.com)
FRESHRSS_URL=

# Your FreshRSS username
FRESHRSS_USERNAME=

# Your FreshRSS API password
# This is NOT your login password! Set it in FreshRSS:
# Settings → Profile → API Management → API password
FRESHRSS_API_PASSWORD=
